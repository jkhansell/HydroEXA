# =====================================================================
# HYDROEXA CORE SIMULATION PARAMETERS
# =====================================================================
HydroEXA.model             = "Roe"  # Roe, RoeExner, RoeNoZProjection, HLLC, LaxWendroff, etc 
HydroEXA.cfl               = 0.5    # CFL safety factor for hydrodynamic time stepping

# Multi-level tagging thresholds (gradient thresholds per AMR level)
# Format is an array matching Level 0, Level 1, Level 2, etc.
HydroEXA.h_grad_thresh     = 0.05  0.02  0.01 0.005
HydroEXA.umag_grad_thresh   = 0.2   0.1   0.05  0.025
HydroEXA.z_grad_thresh   = 1.0   1.25   1.5 1.75  

# =====================================================================
# AMR RUNTIME ADAPTIVITY CONFIGURATION
# =====================================================================
amr.max_level              = 2       # Max internal refinement steps. (Code scales to level+1)
amr.regrid_int             = 10      # Dynamic grid refinement/regridding loop window interval
amr.do_reflux              = 1       # 1 = Enable conservation flux-correction at coarse-fine faces
amr.do_subcycle            = 1       # 1 = Temporal subcycling (fine levels take smaller timesteps)
amr.blocking_factor        = 16

# The target level at which the persistent HDF5 ground truth maps are loaded 
# If your background array resolution matches Level 0, use 0.
amr.terrain_ref_lev        = 2

# Standard AMReX block distribution sizing options
amr.ref_ratio              = 2 2   # Refinement factor between sequential tiers

# =====================================================================
# SYSTEM PARALLEL DATA / INPUT OUTPUT MANAGEMENT
# ====================================================================
io.chk_freq                = 100     # Frequency checkpoint snapshot is dropped
io.plot_freq               = 20      # Plotfile dump interval
io.chk_type                = HDF5    # HDF5 or Native serialization formats
io.async_io                = 1       # 1 = Non-blocking asynchronous I/O threads

# Paths targeting files generated by your python engine scripts
io.input_file              = "SJ.h5"
io.dataset_name            = "bathymetry"     # Default baseline targeting dataset prefix
io.plot_file               = "plt"       # Output filename naming baseline pattern
io.chk_file                = "chk"       # Output checkpoints base naming string

# Restart configurations (Leave commented out on fresh runs)
# IO.restart                = "chk00100"    # Point directly to folder to pick up from a crash