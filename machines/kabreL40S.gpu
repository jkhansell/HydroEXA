#!/bin/bash
# Kabre L40S (Ada, sm_89) — MPICH 4.1.1 + CUDA 12.4 + gcc 13.4
#
# Toolchain only. Build options come from the CMake presets; see
# cmake/presets/card-kabreL40S.gpu.json.

if [ -z "${HYDROEXA_NO_MODULES:-}" ]; then
    module purge
    module load mpich/4.1.1
    module load cuda/12.4.0
    module load gcc/13.4.0
    module load szip/2.1
    module load hdf5/1.14.6-parallel-mpich-4.1.1
fi

export CC="${CC:-mpicc}"
export CXX="${CXX:-mpicxx}"
export FC="${FC:-mpif90}"

export HYDROEXA_GPU_BACKEND="CUDA"
export HYDROEXA_GPU_ARCH="89"
export HYDROEXA_MPI_LINK_WORKAROUND="ON"
