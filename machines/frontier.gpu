#!/bin/bash
# OLCF Frontier — GPU nodes, Cray PrgEnv + ROCm 7.0 (MI250X, gfx90a)
#
# Toolchain only. Build options come from the CMake presets; see
# cmake/presets/card-frontier.gpu.json.

if [ -z "${HYDROEXA_NO_MODULES:-}" ]; then
    module load PrgEnv-cray
    module load cpe/26.03
    module load amd/7.0.2
    module load rocm/7.0.2
    module load craype-accel-amd-gfx90a
    module load craype-x86-trento
    module load cray-mpich/9.1.0
    module load hdf5/1.14.6-mpi
fi

export LD_LIBRARY_PATH="${CRAY_LD_LIBRARY_PATH:-}:${LD_LIBRARY_PATH:-}"
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export HSA_XNACK=1
export MPICH_GPU_SUPPORT_ENABLED=1

export CC="${CC:-cc}"
export CXX="${CXX:-CC}"
export FC="${FC:-ftn}"

# HIP, not CUDA. AMReX requires AMReX_AMD_ARCH when the HIP backend is chosen;
# the preset supplies it from HYDROEXA_GPU_ARCH.
export HYDROEXA_GPU_BACKEND="HIP"
export HYDROEXA_GPU_ARCH="gfx90a"
