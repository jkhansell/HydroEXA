#!/bin/bash
# OLCF Frontier — CPU nodes, Cray PrgEnv (no GPU offload)
#
# Toolchain only. Build options come from the CMake presets; see
# cmake/presets/card-frontier.cpu.json.

if [ -z "${HYDROEXA_NO_MODULES:-}" ]; then
    module load PrgEnv-cray
    module load cpe/26.03
    module load craype-x86-trento
    module load cray-mpich/9.1.0
    module load hdf5/1.14.6-mpi
fi

export LD_LIBRARY_PATH="${CRAY_LD_LIBRARY_PATH:-}:${LD_LIBRARY_PATH:-}"
export OMP_PROC_BIND=spread
export OMP_PLACES=threads

export CC="${CC:-cc}"
export CXX="${CXX:-CC}"
export FC="${FC:-ftn}"

export HYDROEXA_GPU_BACKEND="NONE"
