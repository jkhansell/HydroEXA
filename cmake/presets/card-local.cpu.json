{
  "version": 6,
  "include": [
    "00-backends.json",
    "01-precision.json",
    "02-buildtype.json"
  ],
  "configurePresets": [
    {
      "name": "card-local.cpu",
      "displayName": "Local CPU only (fragment)",
      "description": "Card fragment: no GPU, host compilers from the environment.",
      "inherits": "backend-cpu",
      "binaryDir": "${sourceDir}/build/.fragment/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "ON",
        "HYDROEXA_MACHINE": "local.cpu"
      }
    },
    {
      "name": "local-cpu-double",
      "displayName": "Local CPU / DOUBLE",
      "inherits": ["card-local.cpu", "precision-double", "buildtype-release"],
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "OFF",
        "HYDROEXA_PRESET": "${presetName}"
      }
    },
    {
      "name": "local-cpu-single",
      "displayName": "Local CPU / SINGLE",
      "inherits": ["card-local.cpu", "precision-single", "buildtype-release"],
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "OFF",
        "HYDROEXA_PRESET": "${presetName}"
      }
    }
  ]
}
