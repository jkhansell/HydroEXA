{
  "version": 6,
  "include": [
    "00-backends.json",
    "01-precision.json",
    "02-buildtype.json"
  ],
  "configurePresets": [
    {
      "name": "card-kabreL40S.gpu",
      "displayName": "Kabre L40S - Ada sm_89 (fragment)",
      "description": "Card fragment: CUDA sm_89, MPICH 4.1.1, AMReX MPI link workaround.",
      "inherits": "backend-cuda",
      "binaryDir": "${sourceDir}/build/.fragment/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "ON",
        "HYDROEXA_MACHINE": "kabreL40S.gpu",
        "HYDROEXA_GPU_ARCH": "89",
        "HYDROEXA_MPI_LINK_WORKAROUND": "ON"
      }
    },
    {
      "name": "kabreL40S-gpu-double",
      "displayName": "Kabre L40S / DOUBLE",
      "inherits": ["card-kabreL40S.gpu", "precision-double", "buildtype-release"],
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "OFF",
        "HYDROEXA_PRESET": "${presetName}"
      }
    },
    {
      "name": "kabreL40S-gpu-single",
      "displayName": "Kabre L40S / SINGLE",
      "inherits": ["card-kabreL40S.gpu", "precision-single", "buildtype-release"],
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "HYDROEXA_FRAGMENT_ONLY": "OFF",
        "HYDROEXA_PRESET": "${presetName}"
      }
    }
  ]
}
